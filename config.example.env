# Optional settings for scripts/build.sh. Copy to config.env (git-ignored) to use them.

# Client ID of your Spotify app (developer.spotify.com/dashboard), with redirect URI
# http://127.0.0.1:47821/callback. You can also paste it during setup instead.
SPOTIFY_CLIENT_ID=

# Any reverse-DNS name. Change it only if you have a reason to.
# BUNDLE_ID=app.lipsync.Lipsync

# Where Apple Music plays: "musicapp" (default, no developer account) or "musickit" (needs an
# Apple Developer Program account and BUNDLE_ID registered with MusicKit; see README).
# LIPSYNC_BACKEND=musicapp

# Code-signing identity. Leave unset to pick one automatically.
# SIGN_IDENTITY=
